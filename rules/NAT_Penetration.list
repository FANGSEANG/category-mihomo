# NAT Penetration内网穿透相关

#-------------------------
# Tailscale相关
#-------------------------

# 进程
PROCESS-NAME,tailscaled

# DERP Servers中继服务器，如果启用DOMAIN-SUFFIX,tailscale.com，下面两个可以不开
#DOMAIN-REGEX,^derp\d*-?.*\.tailscale\.com$
#DOMAIN-REGEX,^derp.*tailscale\.com

# 其他域名
DOMAIN-SUFFIX,tailscale.io
DOMAIN-SUFFIX,ts.net
DOMAIN-SUFFIX,tailscale.com

# IP绕过
IP-CIDR,100.64.0.0/10,no-resolve
IP-CIDR,fd7a:115c:a1e0::/48,no-resolve

# 常用端口（仅UDP）
AND,((NETWORK,UDP),(DST-PORT,41641))
AND,((NETWORK,UDP),(SRC-PORT,41641))

# peer relays端口（仅UDP）
AND,((NETWORK,UDP),(DST-PORT,40000))
AND,((NETWORK,UDP),(SRC-PORT,40000))

#-------------------------
# Zerotier相关
#-------------------------

# Domain
#DOMAIN-SUFFIX,cdn77.com
DOMAIN,planet.zerotier.com

# 端口（仅UDP）
AND,((NETWORK,UDP),(DST-PORT,9993))
AND,((NETWORK,UDP),(SRC-PORT,9993))

#-------------------------
# Cloudflare Tunnel
#-------------------------
#DOMAIN-SUFFIX,argotunnel.com
#DOMAIN-SUFFIX,cftunnel.com
#IP-CIDR,198.41.192.0/24,no-resolve
#IP-CIDR,198.41.200.0/24,no-resolve
#DST-PORT,7844
#最新写法
DOMAIN-SUFFIX,argotunnel.com
DOMAIN-SUFFIX,cftunnel.com
AND,((IP-CIDR,198.41.192.0/24),(DST-PORT,7844))
AND,((IP-CIDR,198.41.200.0/24),(DST-PORT,7844))

#-------------------------
# 适合直连的Stun 域名
